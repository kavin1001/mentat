{
  "name": "mentat-sync-server",
  "version": "0.1.0",
  "private": true,
  "description": "Optional, self-hostable relay for Mentat cloud sync. Stores only end-to-end encrypted records.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--preserve-symlinks tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --preserve-symlinks --platform=node --format=esm --target=node22 --outfile=dist/server.js",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=--preserve-symlinks tsx --test test/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@mentat/sync-core": "file:../packages/sync-core",
    "@noble/ciphers": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
