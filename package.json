{
  "name": "mentat",
  "version": "0.1.0",
  "description": "Mentat: botless AI meeting notes. Local system + mic capture, full transcripts, Claude-enhanced notes, Google Drive sync.",
  "main": "out/main/index.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mcp": "node out/main/mcp-server.js",
    "dist:mac": "electron-vite build && electron-builder --mac --config electron-builder.config.cjs",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.config.cjs",
    "postinstall": "node scripts/copy-ort.mjs",
    "predev": "node scripts/copy-ort.mjs",
    "prebuild": "node scripts/copy-ort.mjs",
    "test": "tsx --test test/*.test.ts",
    "dist:dir": "electron-vite build && electron-builder --dir --config electron-builder.config.cjs",
    "release": "electron-vite build && electron-builder --config electron-builder.config.cjs --publish always",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@mentat/sync-core": "file:packages/sync-core",
    "@noble/ciphers": "^2.0.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.0.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-task-item": "^3.33.0",
    "@tiptap/extension-task-list": "^3.33.0",
    "@tiptap/markdown": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kavin1001/mentat.git"
  }
}
